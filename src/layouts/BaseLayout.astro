---
import '@fontsource-variable/nunito-sans';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { contact, siteName } from '../lib/site';

interface Props {
  title: string;
  description: string;
  closing?: boolean;
  noindex?: boolean;
}

const { title, description, closing = false, noindex = false } = Astro.props;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site);
const shareImage = new URL('/images/tsl-kids-share.jpg', site);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Tarbiyah Sunnah Learning Kids',
  alternateName: siteName,
  url: site.toString(),
  sameAs: [contact.website, contact.instagram],
  description: 'Program pembelajaran Al-Qur’an dan ilmu diniyyah untuk anak secara online dengan pendampingan sesuai usia.',
};
---
<!doctype html>
<html lang="id" data-type="service" data-radius="soft" data-buttons="solid">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf8ef" />
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/webp" href="/images/journey-grow.webp" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:alt" content="Meja belajar TSL Kids dengan buku dan tablet" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main id="konten" tabindex="-1"><slot /></main>
    <Footer {closing} />
  </body>
</html>
