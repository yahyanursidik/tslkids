---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import { getPrograms } from '../../lib/programs';

const programs = await getPrograms();
---
<BaseLayout title="Program Belajar Al-Qur’an | TSL Kids" description="Bandingkan usia, jadwal, dan materi empat program Al-Qur’an online dari TSL Kids.">
  <section class="page-hero">
    <div class="container wrap">
      <h1>Program TSL Kids</h1>
      <p class="lede">Pilih madrasah untuk belajar beberapa materi, atau kelas yang berfokus pada bacaan dan hafalan.</p>
      <a class="text-link" href="/#cari-program">Temukan program <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </section>
  <section class="section section--compact catalog-section" aria-labelledby="catalog-title">
    <div class="container wrap">
      <h2 class="sr-only" id="catalog-title">Daftar program</h2>
      <div class="program-grid">
        {programs.map(({ data }) => <ProgramCard program={data} />)}
      </div>
    </div>
  </section>
</BaseLayout>
