---
import { getCollection, render } from 'astro:content';
import { ArrowRight, Check } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';
export async function getStaticPaths() { const programs = await getCollection('programs'); return programs.map((program) => ({ params: { slug: program.data.slug }, props: { program } })); }
const { program } = Astro.props;
const { Content } = await render(program);
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={`${program.data.title} | TSL Kids`} description={program.data.summary}>
  <section class="page-hero"><div class="container content-grid"><div><p class="eyebrow">Program usia {program.data.ageMin}–{program.data.ageMax} tahun</p><h1>{program.data.title}</h1><p class="lede">{program.data.summary}</p><a class="button button--primary" href="/daftar/">Daftar Program <ArrowRight size={17} aria-hidden="true" /></a></div><aside class="content-panel"><ul class="detail-facts"><li><strong>Format</strong><span>{program.data.format}</span></li><li><strong>Mode</strong><span>Online</span></li>{program.data.duration && <li><strong>Durasi</strong><span>{program.data.duration}</span></li>}{program.data.frequency && <li><strong>Pilihan frekuensi</strong><span>{program.data.frequency.join(', ')}</span></li>}</ul></aside></div></section>
  <section class="section section--warm"><div class="container content-grid"><article class="content-panel"><h2>Untuk siapa program ini?</h2><p>{program.data.suitableFor}</p><Content /></article><aside class="content-panel"><h2>Fokus pembelajaran</h2><ul>{program.data.focus.map((item) => <li>{item}</li>)}</ul></aside></div></section>
  <section class="section"><div class="container content-grid"><article><p class="eyebrow">Proses belajar</p><h2>Belajar dimulai dari kemampuan anak saat ini</h2><p class="lede">Pengajar memberi contoh, anak mencoba, lalu bacaan atau pemahaman diperbaiki secara bertahap. Pengulangan membantu proses belajar berjalan lebih mantap.</p></article><aside class="content-panel"><h3>Model pembelajaran</h3><p>{program.data.format} yang dilakukan secara online. Bentuk pendampingan disesuaikan dengan tujuan dan rentang usia program.</p><h3>Hal yang disiapkan</h3><p>Perangkat belajar, suasana yang cukup tenang, dan dukungan orang tua untuk menjaga kebiasaan belajar.</p></aside></div></section>
  <section class="section"><div class="container content-grid"><article><p class="eyebrow">Kemitraan belajar</p><h2>Peran orang tua</h2><p class="lede">{program.data.parentRole}</p></article><aside class="content-panel"><h3>Langkah berikutnya</h3><p>Isi formulir minat untuk memulai percakapan tentang kebutuhan belajar Ananda.</p><a class="button button--primary" href="/daftar/">Mulai pendaftaran <Check size={17} aria-hidden="true" /></a></aside></div></section>
  <section class="section section--warm"><div class="container"><div class="section-heading"><div><p class="eyebrow">Sebelum mendaftar</p><h2>Pertanyaan yang sering dipertimbangkan</h2></div><p>Informasi berikut membantu orang tua memahami bentuk belajar sebelum memilih program.</p></div><FaqList items={faqs} /></div></section>
</BaseLayout>
