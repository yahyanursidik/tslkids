---
import { render } from 'astro:content';
import { ArrowLeft, ArrowRight, MessageCircle } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ageLabel, getPrograms, programIllustration, scheduleLabel } from '../../lib/programs';
import { contact } from '../../lib/site';

export async function getStaticPaths() {
  const programs = await getPrograms();
  return programs.map((program) => ({
    params: { slug: program.data.slug },
    props: { program },
  }));
}

const { program } = Astro.props;
const { Content } = await render(program);
const { data } = program;
const { schedule } = data;
---
<BaseLayout title={`${data.title} | TSL Kids`} description={data.summary}>
  <section class="page-hero program-hero" data-accent={data.accent} aria-labelledby="program-name">
    <div class="container wrap">
      <a class="text-link back-link" href="/program/"><ArrowLeft size={17} aria-hidden="true" /> Semua program</a>
      <div class="program-intro">
        <div>
          <span class="age-label">{ageLabel(data)}</span>
          <h1 id="program-name">{data.title}</h1>
          <p class="lede">{data.summary}</p>
          <a class="button button--primary" href={`/daftar/?program=${data.slug}`}>
            Daftar program ini <ArrowRight size={19} aria-hidden="true" />
          </a>
        </div>
        <img src={programIllustration(data)} alt="" width="448" height="448" decoding="async" />
      </div>
      <dl class="program-facts">
        <div>
          <dt>Format kelas</dt>
          <dd>{data.format}</dd>
        </div>
        <div>
          <dt>Jadwal</dt>
          <dd>{scheduleLabel(data)}</dd>
        </div>
        {schedule.type === 'weekly' && (
          <div>
            <dt>Pilihan waktu</dt>
            <dd>{schedule.timeSlots.join(' · ')}</dd>
          </div>
        )}
        <div>
          <dt>Media belajar</dt>
          <dd>{schedule.type === 'weekly' ? schedule.platform : 'Kelas online'}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="curriculum-title">
    <div class="container wrap content-grid">
      <article class="curriculum">
        <h2 id="curriculum-title">Materi pembelajaran</h2>
        <Content />
      </article>
      <aside class="support-panel">
        <h2>Konsultasi program</h2>
        <p>Diskusikan kemampuan awal dan waktu belajar Ananda dengan admin TSL Kids.</p>
        <a class="button button--secondary" href={contact.whatsapp}><MessageCircle size={18} aria-hidden="true" /> Tanya admin</a>
        <a class="text-link" href="/faq/">Baca pertanyaan umum <ArrowRight size={17} aria-hidden="true" /></a>
      </aside>
    </div>
  </section>
</BaseLayout>
