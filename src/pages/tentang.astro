---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../lib/site';
---
<BaseLayout title="Tentang TSL Kids" description="Kenali Tarbiyah Sunnah Learning Kids dan pilihan belajar Al-Qur’an untuk anak.">
  <section class="page-hero">
    <div class="container wrap">
      <h1>Tentang TSL Kids</h1>
      <p class="lede">Tarbiyah Sunnah Learning Kids mendampingi anak belajar Al-Qur’an secara online melalui kelas madrasah, bacaan, dan hafalan.</p>
    </div>
  </section>
  <section class="section section--compact">
    <div class="container wrap content-grid">
      <div>
        <h2>Belajar sesuai usia</h2>
        <p>Di kelas madrasah, Ananda belajar bersama teman dan mendapat giliran bimbingan individual. Kelas fokus memberi ruang untuk berlatih bacaan atau hafalan sesuai kemampuan.</p>
        <a class="text-link" href="/program/">Lihat semua program <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <aside class="support-panel">
        <h2>Kontak TSL Kids</h2>
        <ul class="related-programs">
          <li><a class="text-link" href={contact.whatsapp}>WhatsApp {contact.whatsappLabel}</a></li>
          <li><a class="text-link" href={contact.instagram}>Instagram {contact.instagramLabel}</a></li>
          <li><a class="text-link" href={contact.website}>Website {contact.websiteLabel}</a></li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
