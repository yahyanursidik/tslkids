---
import { Ear, MessageCircle, Check, RefreshCw, Sprout } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Cara Belajar | TSL Kids" description="Memahami proses pembelajaran Al-Qur'an anak yang bertahap dan terarah di TSL Kids.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Cara belajar</p><h1>Belajar yang memberi ruang untuk bertumbuh</h1><p class="lede">Pembelajaran dimulai dari kemampuan anak saat ini, lalu dilanjutkan dengan latihan dan pendampingan yang konsisten.</p></div></section>
  <section class="section section--warm"><div class="container"><div class="talaqqi"><div class="talaqqi-stage"><Ear size={18} aria-hidden="true" /><strong>Mendengar</strong><span>Pengajar memberi contoh bacaan.</span></div><div class="talaqqi-stage"><MessageCircle size={18} aria-hidden="true" /><strong>Menirukan</strong><span>Anak mencoba dalam tempo yang sesuai.</span></div><div class="talaqqi-stage"><Check size={18} aria-hidden="true" /><strong>Diperbaiki</strong><span>Kesalahan diperbaiki secara bertahap.</span></div><div class="talaqqi-stage"><RefreshCw size={18} aria-hidden="true" /><strong>Mengulang</strong><span>Latihan membantu bacaan menjadi lebih mantap.</span></div><div class="talaqqi-stage"><Sprout size={18} aria-hidden="true" /><strong>Bertumbuh</strong><span>Kebiasaan belajar dibangun dari proses kecil yang konsisten.</span></div></div></div></section>
</BaseLayout>
