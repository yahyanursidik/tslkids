---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const teachers = (await getCollection('teachers')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Pengajar | TSL Kids" description="Mengenal pendekatan pendampingan pengajar TSL Kids.">
  <section class="page-hero"><div class="container"><p class="eyebrow">Pengajar</p><h1>Pendampingan yang memperhatikan proses anak</h1><p class="lede">Pengajar TSL Kids mendampingi pembelajaran secara bertahap dan membantu orang tua memahami perjalanan belajar Ananda.</p></div></section>
  <section class="section section--warm"><div class="container content-grid">{teachers.map((teacher) => <article class="content-panel"><p class="eyebrow">{teacher.data.role}</p><h2>{teacher.data.name}</h2><p>{teacher.data.bio}</p><p><strong>Program:</strong> {teacher.data.programs.join(', ')}</p></article>)}<aside class="content-panel"><h2>Komunikasi yang terbuka</h2><p>Informasi perkembangan dan kebutuhan pendampingan dibicarakan dalam konteks proses belajar anak.</p></aside></div></section>
</BaseLayout>
