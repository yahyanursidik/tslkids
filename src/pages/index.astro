---
import { ArrowRight, Video } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LearningSteps from '../components/LearningSteps.astro';
import ProgramCard from '../components/ProgramCard.astro';
import ProgramFinder from '../components/ProgramFinder.astro';
import { getPrograms, programAges } from '../lib/programs';
import '../styles/home.css';

const programs = (await getPrograms()).map(({ data }) => data);
const ages = programAges(programs);
const ageRange = `${ages[0]}–${ages.at(-1)} tahun`;
---
<BaseLayout
  title="TSL Kids | Belajar Al-Qur’an Online untuk Anak"
  description={`Kelas madrasah, latihan bacaan, dan hafalan Al-Qur’an untuk anak usia ${ageRange}. Temukan program yang sesuai dengan usia dan tujuan belajar Ananda.`}
  closing
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/taste/motion/motion.css" />
    <script is:inline>
      document.documentElement.classList.add('m-enter');
      setTimeout(() => document.documentElement.classList.add('m-enter-done'), 700);
    </script>
  </Fragment>
  <section class="hero hero--photo" aria-labelledby="home-title" data-enter>
    <div class="container wrap hero-inner">
      <div class="hero-text">
        <p class="hero-fact"><Video size={18} aria-hidden="true" /> Kelas online · Usia {ageRange}</p>
        <h1 id="home-title">Belajar Al-Qur’an <span class="hero-title-accent">untuk anak</span></h1>
        <p class="hero-lead hero__lead">Pilih kelas madrasah, latihan bacaan, atau hafalan dengan bimbingan guru yang menyesuaikan kemampuan Ananda.</p>
        <div class="button-row btn-row">
          <a class="button button--primary" href="#cari-program">Temukan program <ArrowRight size={19} aria-hidden="true" /></a>
          <a class="button button--secondary" href="#program">Lihat semua program</a>
        </div>
      </div>
    </div>
    <picture class="hero-media hero__media layer" data-enter-media aria-hidden="true">
      <img
        src="/images/hero-learning-space-1440.webp"
        srcset="/images/hero-learning-space-768.webp 768w, /images/hero-learning-space-1440.webp 1440w"
        sizes="(min-width: 1024px) 78vw, 100vw"
        alt=""
        width="1440"
        height="1080"
        fetchpriority="high"
        decoding="async"
        data-source="client"
        data-subject="work"
      />
    </picture>
  </section>

  <section class="section home-programs" id="program" aria-labelledby="program-title">
    <div class="container wrap">
      <header class="section-heading">
        <h2 id="program-title">Empat pilihan belajar</h2>
        <p>Bandingkan usia, jadwal, dan materi untuk menemukan kelas yang cocok bagi Ananda.</p>
      </header>
      <div class="program-grid">
        {programs.map((program) => <ProgramCard {program} />)}
      </div>
    </div>
  </section>

  <section class="section section--sage" id="cari-program" aria-labelledby="finder-title">
    <div class="container wrap">
      <header class="section-heading">
        <h2 id="finder-title">Pilihan kelas sesuai usia</h2>
        <p>Mulai dari usia Ananda dan satu hal yang ingin dipelajari.</p>
      </header>
      <ProgramFinder {programs} />
    </div>
  </section>

  <section class="section home-learning" aria-labelledby="learning-title">
    <div class="container wrap">
      <header class="section-heading">
        <h2 id="learning-title">Cara Ananda belajar</h2>
        <p>Guru memberi contoh, lalu Ananda mencoba dan berlatih kembali dengan bimbingan.</p>
      </header>
      <LearningSteps />

      <div class="parent-feature">
        <div class="parent-copy panel">
          <h3>Mendampingi dari rumah</h3>
          <p>Siapkan tempat belajar yang nyaman, temani Ananda mengulang bacaan, dan diskusikan latihannya dengan pengajar.</p>
          <a class="button button--secondary" href="/cara-belajar/">Lihat cara belajar <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
        <figure class="parent-photo frame frame--photo" data-moment="picture-develops">
          <img
            src="/images/parent-partnership.webp"
            srcset="/images/parent-partnership-480.webp 480w, /images/parent-partnership-720.webp 720w, /images/parent-partnership.webp 960w"
            sizes="auto, (min-width: 90rem) 39.25rem, (min-width: 42rem) 44vw, 89vw"
            alt="Sudut rumah dengan sofa dan meja kecil untuk menemani anak belajar"
            width="960"
            height="720"
            loading="lazy"
            decoding="async"
            data-source="client"
            data-subject="use"
          />
        </figure>
      </div>
    </div>
  </section>
  <script is:inline type="module" src="/taste/motion/motion.js"></script>
  <script is:inline type="module" src="/taste/moments/moments.js"></script>
</BaseLayout>
