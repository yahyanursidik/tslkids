---
import { getCollection } from 'astro:content';
import { ArrowRight, Check } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgramCard from '../components/ProgramCard.astro';
import ProgramFinder from '../components/ProgramFinder.astro';
const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="TSL Kids | Belajar Al-Qur'an untuk Anak" description="Program belajar Al-Qur'an online untuk anak usia 4–15 tahun, dengan pendampingan sesuai usia dan kebutuhan belajar.">
  <div class="home-shell">
  <section class="hero"><div class="container hero-grid">
    <div class="hero-copy-surface">
      <p class="eyebrow">Tarbiyah Sunnah Learning Kids</p>
      <h1 class="hero-title">Belajar Al-Qur'an. Sedikit demi sedikit. Bertumbuh sepanjang perjalanan.</h1>
      <p class="hero-copy">Program belajar Al-Qur'an online untuk anak usia 4–15 tahun melalui kelas usia dini, pembelajaran private, dan Madrasah Qur'an semester.</p>
      <div class="hero-actions"><a class="button button--primary" href="#program-finder">Temukan Program untuk Ananda <ArrowRight size={17} aria-hidden="true" /></a><a class="button button--secondary" href="#program">Lihat Semua Program</a></div>
    </div>
    <figure class="hero-media"><img src="/images/hero-learning-space.png" alt="Ruang belajar dengan buku, pensil, tanaman, dan perangkat kelas online yang menampilkan kemajuan belajar" width="1440" height="1080" fetchpriority="high" decoding="async" /></figure>
  </div></section>
  <section class="home-programs" id="program"><div class="container">
    <div class="program-grid">{programs.map((program) => <ProgramCard {...program.data} />)}</div>
  </div></section>
  <section class="home-workspace"><div class="container home-workspace-grid"><ProgramFinder {programs} /><div class="home-side-stack"><section class="learning-journey-panel"><div class="panel-heading"><h2>Perjalanan Belajar</h2><p>Proses sederhana yang kami dampingi bersama Ananda.</p></div><div class="journey journey--horizontal" aria-label="Proses pendampingan belajar"><div class="journey-step"><img class="journey-icon" src="/images/journey-ear.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Mendengar</h3><p>Ananda mendengar contoh dari pengajar.</p></div></div><div class="journey-step"><img class="journey-icon" src="/images/journey-chat.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Menirukan</h3><p>Ananda mencoba bacaan dengan bimbingan.</p></div></div><div class="journey-step"><img class="journey-icon" src="/images/journey-check.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Diperbaiki</h3><p>Pengajar membimbing bacaan agar tepat.</p></div></div><div class="journey-step"><img class="journey-icon" src="/images/journey-repeat.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Mengulang</h3><p>Ananda mengulang hingga lebih mantap.</p></div></div><div class="journey-step"><img class="journey-icon" src="/images/journey-grow.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Bertumbuh</h3><p>Kebiasaan baik hari ini menjadi bekal.</p></div></div></div></section><section class="parent-panel"><figure class="parent-scene"><img src="/images/parent-partnership.png" alt="Ruang keluarga yang tenang dengan tanaman dan meja kecil" width="1440" height="1080" loading="lazy" decoding="async" /></figure><div class="parent-panel-copy"><h2>Peran Orang Tua,<br />Kemajuan Ananda</h2><p>Kami percaya, dukungan orang tua adalah kunci. Dapatkan laporan perkembangan rutin, panduan pendampingan, dan komunikasi yang terbuka.</p><ul class="partnership-list"><li><Check size={16} aria-hidden="true" />Laporan perkembangan</li><li><Check size={16} aria-hidden="true" />Panduan orang tua</li><li><Check size={16} aria-hidden="true" />Komunikasi terbuka</li></ul></div></section></div></div></section>
  </div>
</BaseLayout>
