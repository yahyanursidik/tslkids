---
import { getCollection } from 'astro:content';
import { ArrowRight, Check } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgramCard from '../components/ProgramCard.astro';
import ProgramFinder from '../components/ProgramFinder.astro';
import FaqList from '../components/FaqList.astro';
const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="TSL Kids | Belajar Al-Qur'an untuk Anak" description="Program belajar Al-Qur'an online untuk anak usia 4–15 tahun, dengan pendampingan sesuai usia dan kebutuhan belajar.">
  <section class="hero"><div class="container hero-grid">
    <div>
      <p class="eyebrow">Tarbiyah Sunnah Learning Kids</p>
      <h1 class="hero-title">Belajar Al-Qur'an. Sedikit demi sedikit. Bertumbuh sepanjang perjalanan.</h1>
      <p class="hero-copy">Program belajar Al-Qur'an online untuk anak usia 4–15 tahun melalui kelas usia dini, pembelajaran private, dan Madrasah Qur'an semester.</p>
      <div class="hero-actions"><a class="button button--primary" href="#program-finder">Temukan Program <ArrowRight size={17} aria-hidden="true" /></a><a class="button button--secondary" href="#program">Lihat Semua Program</a></div>
    </div>
    <figure class="hero-media"><img src="/images/hero-learning-space.png" alt="Ruang belajar dengan buku, pensil, tanaman, dan perangkat kelas online yang menampilkan kemajuan belajar" width="1440" height="1080" fetchpriority="high" decoding="async" /></figure>
  </div></section>
  <div class="container program-rail" aria-label="Ringkasan program">
    <div class="program-marker marker--yellow"><span>4–6 tahun</span><strong>Madrasah Usia Dini</strong></div>
    <div class="program-marker marker--sky"><span>6–13 tahun</span><strong>Qur'an Private Anak</strong></div>
    <div class="program-marker marker--sage"><span>7–15 tahun</span><strong>Madrasah Qur'an Anak</strong></div>
  </div>
  <section class="section" id="program"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">Pilih sesuai tahapnya</p><h2>Program untuk setiap tahap dan kebutuhan belajar</h2></div><p>Setiap program memiliki usia, format, dan fokus yang berbeda agar orang tua tidak perlu menebak bentuk pendampingan yang sesuai.</p></div>
    <div class="program-grid">{programs.map((program) => <ProgramCard {...program.data} />)}</div>
  </div></section>
  <section class="section section--warm"><div class="container"><ProgramFinder {programs} /></div></section>
  <section class="section"><div class="container approach">
    <div class="approach-copy"><p class="eyebrow">Cara kami mendampingi</p><h2>Anak tidak harus belajar dengan cara yang sama</h2><p class="lede">Setiap anak datang dengan kemampuan, pengalaman, rentang perhatian, dan kecepatan belajar yang berbeda. Karena itu pembelajaran perlu mengetahui di mana kemampuan anak sekarang.</p></div>
    <div class="journey" aria-label="Proses pendampingan belajar">
      <div class="journey-step"><img class="journey-icon" src="/images/journey-ear.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Kenali</h3><p>Memahami titik awal dan kebutuhan belajar Ananda.</p></div></div>
      <div class="journey-step"><img class="journey-icon" src="/images/journey-chat.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Dampingi</h3><p>Memberi arahan yang tenang sesuai format kelas.</p></div></div>
      <div class="journey-step"><img class="journey-icon" src="/images/journey-check.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Latih</h3><p>Anak mencoba materi dan membangun kebiasaan dengan langkah kecil.</p></div></div>
      <div class="journey-step"><img class="journey-icon" src="/images/journey-repeat.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Evaluasi</h3><p>Mengulang dan memperbaiki bagian yang masih perlu dikuatkan.</p></div></div>
      <div class="journey-step"><img class="journey-icon" src="/images/journey-grow.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><div><h3>Lanjutkan</h3><p>Melanjutkan perjalanan belajar sesuai kesiapan Ananda.</p></div></div>
    </div>
  </div></section>
  <section class="section section--warm"><div class="container"><div class="section-heading"><div><p class="eyebrow">Perjalanan talaqqi</p><h2>Belajar berlangsung melalui proses yang berulang dan terarah</h2></div><p>Pengulangan bukan sekadar menghafal. Ini membantu anak mendengar, mencoba, menerima perbaikan, dan tumbuh lebih mantap.</p></div><div class="talaqqi"><div class="talaqqi-stage"><img src="/images/journey-ear.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><strong>Mendengar</strong></div><div class="talaqqi-stage"><img src="/images/journey-chat.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><strong>Menirukan</strong></div><div class="talaqqi-stage"><img src="/images/journey-check.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><strong>Diperbaiki</strong></div><div class="talaqqi-stage"><img src="/images/journey-repeat.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><strong>Mengulang</strong></div><div class="talaqqi-stage"><img src="/images/journey-grow.png" alt="" width="1280" height="1280" loading="lazy" decoding="async" /><strong>Bertumbuh</strong></div></div></div></section>
  <section class="section"><div class="container parent-partnership"><figure class="parent-scene"><img src="/images/parent-partnership.png" alt="Ruang keluarga yang tenang dengan tanaman dan meja kecil" width="1440" height="1080" loading="lazy" decoding="async" /></figure><div><p class="eyebrow">Bersama orang tua</p><h2>Orang tua tetap menjadi bagian dari perjalanan belajar</h2><p class="lede">Pembelajaran online tidak menggantikan peran orang tua. Dukungan kecil yang konsisten membantu anak merasa ditemani.</p><div class="partnership-note"><h2>Kemajuan Ananda dibangun bersama</h2><ul class="partnership-list"><li><Check size={18} aria-hidden="true" />Menyiapkan lingkungan belajar yang nyaman.</li><li><Check size={18} aria-hidden="true" />Menjaga kebiasaan murojaah di rumah.</li><li><Check size={18} aria-hidden="true" />Berkomunikasi dengan pengajar saat diperlukan.</li></ul></div></div></div></section>
  <section class="section section--compact"><div class="container teacher-strip"><div><p class="eyebrow">Kepercayaan proses</p><h2>Belajar tidak ditinggalkan sendirian</h2></div><div class="teacher-fact"><strong>Terarah</strong><span>Pembelajaran melihat tahap dan kebutuhan anak.</span></div><div class="teacher-fact"><strong>Terhubung</strong><span>Orang tua tetap mendapat ruang untuk mendampingi.</span></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Pertanyaan yang sering muncul</p><h2>Hal yang biasanya ingin diketahui orang tua</h2></div><p>Jawaban singkat untuk membantu Anda memahami program sebelum berkonsultasi.</p></div><FaqList items={faqs} /><p class="faq-action"><a class="button button--secondary" href="/faq/">Lihat semua FAQ</a></p></div></section>
  <section class="section--ink"><div class="container final-cta"><div><p class="eyebrow">Mulai dari yang sesuai</p><h2>Temukan program yang tepat untuk Ananda</h2><p>Mulai dari usia, kebutuhan belajar, dan bentuk pendampingan yang paling sesuai.</p></div><div><a class="button button--light" href="/daftar/">Cari Program <ArrowRight size={17} aria-hidden="true" /></a></div></div></section>
</BaseLayout>
