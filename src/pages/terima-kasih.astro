---
import { ArrowRight, CircleCheck } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../lib/site';
---
<BaseLayout title="Terima kasih | TSL Kids" description="Konfirmasi pengiriman formulir minat belajar TSL Kids." noindex>
  <section class="page-hero confirmation">
    <div class="container wrap">
      <CircleCheck size={44} aria-hidden="true" />
      <h1>Minat belajar terkirim</h1>
      <p class="lede">Terima kasih. Admin dapat menghubungi Anda melalui nomor WhatsApp yang dicantumkan pada formulir.</p>
      <div class="button-row">
        <a class="button button--primary" href="/program/">Lihat program <ArrowRight size={19} aria-hidden="true" /></a>
        <a class="button button--secondary" href={contact.whatsapp}>Hubungi admin</a>
      </div>
    </div>
  </section>
</BaseLayout>
