---
import { ArrowRight, Compass } from '@lucide/astro';
import { ageLabel, programAges, programUrl, scheduleLabel, type Program } from '../lib/programs';

interface Props { programs: Program[] }
const { programs } = Astro.props;
const goals = [
  { value: 'madrasah', label: 'Belajar di madrasah' },
  { value: 'bacaan', label: 'Memperbaiki bacaan' },
  { value: 'hafalan', label: 'Menghafal Al-Qur’an' },
];
---
<div data-program-finder>
  <div class="finder" data-finder-controls hidden>
    <div class="finder-fields">
      <div class="field">
        <label for="finder-age">Usia Ananda</label>
        <select id="finder-age" name="age">
          <option value="">Pilih usia</option>
          {programAges(programs).map((age) => <option value={age}>{age} tahun</option>)}
        </select>
      </div>
      <fieldset class="finder-goals">
        <legend>Tujuan belajar</legend>
        {goals.map(({ value, label }) => (
          <label class="finder-option">
            <input type="radio" name="goal" {value} />
            <span>{label}</span>
          </label>
        ))}
      </fieldset>
    </div>

    <div class="finder-results">
      <div class="finder-result-head">
        <Compass size={22} aria-hidden="true" />
        <h3>Pilihan untuk Ananda</h3>
      </div>
      <p class="finder-status" role="status" data-finder-status>Pilih usia dan tujuan belajar untuk melihat program yang sesuai.</p>
      <ul class="finder-matches">
        {programs.map((program) => (
          <li data-finder-match data-track={program.track} data-age-min={program.ageMin} data-age-max={program.ageMax} hidden>
            <a class="finder-match" href={programUrl(program)}>
              <span>
                <strong>{program.title}</strong>
                <small>{ageLabel(program)} · {scheduleLabel(program)}</small>
              </span>
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p data-finder-fallback>
    <a class="text-link" href="/program/">Bandingkan rentang usia dan materi program <ArrowRight size={18} aria-hidden="true" /></a>
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-program-finder]').forEach((finder) => {
    const controls = finder.querySelector<HTMLElement>('[data-finder-controls]');
    const fallback = finder.querySelector<HTMLElement>('[data-finder-fallback]');
    const ageSelect = finder.querySelector<HTMLSelectElement>('select[name="age"]');
    const status = finder.querySelector<HTMLElement>('[data-finder-status]');
    const programs = Array.from(finder.querySelectorAll<HTMLElement>('[data-finder-match]'));
    if (!controls || !fallback || !ageSelect || !status) return;

    const update = () => {
      const age = Number(ageSelect.value);
      const goal = finder.querySelector<HTMLInputElement>('input[name="goal"]:checked')?.value;
      const eligible = programs.filter(({ dataset }) => age >= Number(dataset.ageMin) && age <= Number(dataset.ageMax));
      const matching = eligible.filter(({ dataset }) => dataset.track === goal);
      const shown = age && goal ? (matching.length ? matching : eligible) : [];

      programs.forEach((program) => { program.hidden = !shown.includes(program); });

      if (!age || !goal) {
        status.textContent = 'Pilih usia dan tujuan belajar untuk melihat program yang sesuai.';
      } else if (!shown.length) {
        status.textContent = 'Belum ada pilihan untuk usia ini. Hubungi admin untuk berdiskusi.';
      } else if (matching.length > 1 && goal === 'madrasah') {
        status.textContent = `Kedua madrasah menerima anak usia ${age} tahun. Bandingkan jadwal dan materinya.`;
      } else if (!matching.length) {
        status.textContent = `Latihan ${goal} untuk usia ${age} tahun tersedia dalam program madrasah berikut.`;
      } else {
        status.textContent = `Pilihan untuk ${goal === 'madrasah' ? 'kelas madrasah' : goal} pada usia ${age} tahun.`;
      }
    };

    controls.hidden = false;
    fallback.hidden = true;
    controls.addEventListener('change', update);
    window.addEventListener('pageshow', update);
    update();
  });
</script>
