---
import { ArrowRight, CalendarDays } from '@lucide/astro';
import { ageLabel, programIllustration, programUrl, scheduleLabel, type Program } from '../lib/programs';

interface Props { program: Program }
const { program } = Astro.props;
const illustration = programIllustration(program);
const illustrationSources = `${programIllustration(program, 144)} 144w, ${programIllustration(program, 224)} 224w, ${illustration} 448w`;
---
<article class="program-card card" data-accent={program.accent} data-track={program.track}>
  <a class="program-card-link" href={programUrl(program)} aria-labelledby={`card-${program.slug}`}>
    <div class="program-card-copy">
      <span class="age-label">{ageLabel(program)}</span>
      <h3 id={`card-${program.slug}`}>{program.title}</h3>
      <p>{program.summary}</p>
      <span class="program-schedule"><CalendarDays size={17} aria-hidden="true" />{scheduleLabel(program)}</span>
    </div>
    <img
      class="program-card-visual"
      src={illustration}
      srcset={illustrationSources}
      sizes="auto, (min-width: 90rem) 12.5rem, (min-width: 56rem) 14vw, (min-width: 42rem) 12vw, max(4.5rem, 25vw)"
      alt=""
      width="448"
      height="448"
      loading="lazy"
      decoding="async"
    />
    <span class="card-arrow" aria-hidden="true"><ArrowRight size={20} /></span>
  </a>
</article>
