---
import { ArrowRight } from 'lucide-astro';
interface Props { title: string; shortTitle?: string; slug: string; ageMin: number; ageMax: number; summary: string; accent: 'yellow' | 'sky' | 'sage'; }
const { title, shortTitle, slug, ageMin, ageMax, summary, accent } = Astro.props;
const visuals = {
  yellow: { src: '/images/growth-blocks.png', alt: 'Balok belajar dan tanaman muda' },
  sky: { src: '/images/private-notebook.png', alt: 'Buku catatan dan pensil untuk pembelajaran private' },
  sage: { src: '/images/madrasah-book.png', alt: "Buku Al-Qur'an dan tanaman untuk Madrasah Qur'an Anak" },
};
const visual = visuals[accent];
---
<article class={`program-card program-card--${accent}`}>
  <span class="age-chip">{ageMin}–{ageMax} tahun</span>
  <div class="program-card-copy"><h3>{shortTitle ?? title}</h3><p>{summary}</p></div>
  <img class="program-card-visual" src={visual.src} alt={visual.alt} width="1280" height="1280" loading="lazy" decoding="async" />
  <a class="program-card-arrow" href={`/program/${slug}/`} aria-label={`Lihat detail ${title}`}><ArrowRight size={16} aria-hidden="true" /></a>
</article>
