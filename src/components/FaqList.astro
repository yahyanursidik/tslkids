---
import { Plus } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props { items: CollectionEntry<'faqs'>[] }
const { items } = Astro.props;
---
<div class="faq-list">
  {items.map(({ data }) => (
    <details name="pertanyaan-program">
      <summary><span>{data.question}</span><Plus size={21} aria-hidden="true" /></summary>
      <p>{data.answer}</p>
    </details>
  ))}
</div>
