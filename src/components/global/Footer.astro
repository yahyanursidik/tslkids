---
import { ArrowUpRight, MessageCircle, Sprout } from '@lucide/astro';
import { getPrograms, programUrl } from '../../lib/programs';
import { contact, siteTagline } from '../../lib/site';

const { closing = false } = Astro.props as { closing?: boolean };
const programs = await getPrograms();
---
<footer class:list={['site-footer', { closing }]} id="kontak">
  <div class="container wrap">
    {closing && (
      <div class="footer-callout">
        <div>
          <h2>Konsultasi program</h2>
          <p>Ceritakan usia dan kebutuhan belajar Ananda kepada admin TSL Kids.</p>
        </div>
        <a class="text-link footer-contact-link" href={contact.whatsapp}>
          <MessageCircle size={19} aria-hidden="true" /> Tanya admin
        </a>
      </div>
    )}
    <div class="footer-directory">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="TSL Kids, beranda">
            <span class="brand-mark"><Sprout size={21} aria-hidden="true" /></span>
            <span>TSL Kids</span>
          </a>
          <p>Tarbiyah Sunnah Learning Kids</p>
          <p class="footer-tagline">{siteTagline}</p>
        </div>
        <nav class="footer-links" aria-label="Program TSL Kids">
          <p class="footer-label">Program</p>
          <ul>
            {programs.map(({ data }) => <li><a href={programUrl(data)}>{data.title}</a></li>)}
          </ul>
        </nav>
        <nav class="footer-links" aria-label="Bantuan dan kontak">
          <p class="footer-label">Kontak resmi</p>
          <ul>
            <li><a href={contact.whatsapp}>WhatsApp {contact.whatsappLabel} <ArrowUpRight size={14} aria-hidden="true" /></a></li>
            <li><a href={contact.instagram}>Instagram {contact.instagramLabel} <ArrowUpRight size={14} aria-hidden="true" /></a></li>
            <li><a href={contact.website}>Website {contact.websiteLabel} <ArrowUpRight size={14} aria-hidden="true" /></a></li>
          </ul>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>© {new Date().getFullYear()} TSL Kids</p>
        <a href="/kebijakan-privasi/">Kebijakan Privasi</a>
        <a href="/syarat-ketentuan/">Syarat &amp; Ketentuan</a>
      </div>
    </div>
  </div>
</footer>
